# Headlyn daily newsletter environment
# Copy this file to .env, replace the placeholders, and load it before using
# the --send flag. Preview mode does not require Mailjet configuration.

# Mailjet Send API v3.1 credentials
MJ_APIKEY_PUBLIC=your-mailjet-public-api-key
MJ_APIKEY_PRIVATE=your-mailjet-private-api-key

# Must be a sender address validated in Mailjet
HEADLYN_MAILJET_FROM=your-confirmed-sender@example.com
HEADLYN_MAILJET_FROM_NAME=Headlyn
HEADLYN_MAILJET_REPLY_TO=your-confirmed-sender@example.com

# Comma-separated internal/test recipients. Do not commit real addresses.
HEADLYN_RECIPIENTS=first-recipient@example.com,second-recipient@example.com

# Footer text included in HTML and plain-text editions.
HEADLYN_UNSUBSCRIBE_INSTRUCTIONS="Reply to this email to unsubscribe."

# The pipeline defaults to the local Ollama Gemma model and BGE-M3 model.
# Override those values with CLI flags when needed:
#   --entity-model gemma4:e4b-it-q4_K_M
#   --newsletter-model gemma4:e4b-it-q4_K_M
#   --llm-endpoint http://127.0.0.1:11434/api/generate
#   --lexical-model BAAI/bge-m3
